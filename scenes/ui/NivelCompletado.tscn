[node name="Aprendizaje" type="Label" parent="Panel/Margen/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 29
text = "• Un ecosistema es un lugar donde los seres vivos (peces, plantas, aves) se relacionan con el agua, el suelo y el aire.
• La basura en el agua daña a los peces, a las plantas y a todos los que la beben.
• Cuando el agua está limpia, los seres vivos pueden volver a vivir ahí.
• Tú también eres {guardian}: tira la basura en su lugar y recicla."
autowrap_mode = 3

